<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pixel-level tests: headless WITH real Skia rendering, so server-side (composition)
       state becomes observable through captured frames. Separate from SukiUI.Motion.Tests,
       whose headless session uses headless drawing (fast, no pixels). The compositor's
       server clock is a real Stopwatch: these tests run on real time, with wide tolerances. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukiUI.Motion\SukiUI.Motion.csproj" />
  </ItemGroup>

</Project>
