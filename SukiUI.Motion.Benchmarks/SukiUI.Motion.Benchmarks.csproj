<Project Sdk="Microsoft.NET.Sdk">

  <!-- Micro-benchmarks for phase 3 (PLAN §4, rule R3: measure before and after).
       Run: see SukiUI.Motion.Benchmarks/README.md
       Avalonia runs headless on the benchmark thread (UiSession). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SUKIMOTION001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukiUI.Motion\SukiUI.Motion.csproj" />
  </ItemGroup>

</Project>
